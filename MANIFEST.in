include .gitignore LICENSE NOTICE README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md THIRD_PARTY.md pyproject.toml
recursive-include docs *.md *.gif *.txt *.json
recursive-include tools *.py
recursive-include registry *.json
recursive-include .github *.yml
recursive-include prototype *.py
recursive-include prototype/evals *.json *.md
include prototype/requirements-semantic-lock.txt
prune research
prune evaluation
prune releases
prune work
prune prototype/__pycache__
recursive-exclude * __pycache__ *.pyc *.jsonl *.db *.log

include server.json

recursive-include prototype/evals/savings-real *.rst *.txt
include docs/benchmarks/savings-real-fake-spot-check.csv

# Published benchmark run data stays in the repository, not in source distributions.
prune docs/benchmarks/savings-real-full-2026-11-22
prune docs/benchmarks/savings-real-pilot-2026-11-22
prune docs/benchmarks/savings-real-pilot-2026-11-22-regrade
